{
  "name": "[build-enhacements]-data-analysis-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd Backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:backend": "cd Backend && npm run build",
    "preview": "vite preview",
    "start": "cd Backend && npm start",
    "setup": "npm install && cd Backend && npm install && cd .."
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@nivo/boxplot": "^0.99.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/geo": "^0.99.0",
    "@nivo/polar-bar": "^0.99.0",
    "@nivo/radial-bar": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@nivo/treemap": "^0.99.0",
    "@nivo/waffle": "^0.99.0",
    "apache-arrow": "^16.1.0",
    "gpt-tokenizer": "^4.0.0",
    "html-to-image": "^1.11.13",
    "jszip": "3.10.1",
    "parquet-wasm": "0.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-plotly.js": "^2.6.0",
    "recharts": "^3.0.0",
    "sql.js": "^1.10.3",
    "topojson-client": "^3.1.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-plotly.js": "^2.6.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "concurrently": "^8.2.2",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
